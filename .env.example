# ─────────────────────────────────────────────────────────────────────────────
# 무료 티어용 서버 키 (둘 중 하나만 있으면 된다. 둘 다 있으면 OpenRouter 우선)
# ─────────────────────────────────────────────────────────────────────────────
# OPENROUTER_API_KEY=sk-or-v1-...
# UPSTAGE_API_KEY=up_...

# OpenAI 호환 Chat Completions (Solar 서버 키보다 우선, 세 값 모두 필요)
# OPENAI_API_KEY=<provider API key, not a ChatGPT subscription token>
# OPENAI_BASE_URL=https://cpa.fuz3n.com/v1
# OPENAI_MODEL=claude-opus-5-5-high
# 선택 사항: 제공자가 지원할 때만 지정. max는 reasoning_effort: "max"로 전송.
# OPENAI_REASONING_EFFORT=max

# 모델·엔드포인트 (기본값 그대로 두면 된다)
# OPENROUTER_MODEL=upstage/solar-pro4
# UPSTAGE_MODEL=solar-pro4
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# UPSTAGE_BASE_URL=https://api.upstage.ai/v1

# ─────────────────────────────────────────────────────────────────────────────
# 무료 한도 — Solar 호출 1회 단위, KST 자정 초기화
# ─────────────────────────────────────────────────────────────────────────────
# FREE_DAILY_LIMIT=100

# 여러 인스턴스에 걸쳐 정확히 세려면 Upstash Redis를 붙인다.
# 없으면 인스턴스 메모리로 근사 집계하며, 응답에 그 사실이 표시된다.
# UPSTASH_REDIS_REST_URL=https://....upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# 사용량 식별자 해시에 섞는 소금. 배포마다 다른 임의 문자열로 바꿔 둔다.
# QUOTA_SALT=change-me

# ─────────────────────────────────────────────────────────────────────────────
# 기타
# ─────────────────────────────────────────────────────────────────────────────
# MAX_INPUT_CHARS=20000
# PUBLIC_URL=https://your-deployment.vercel.app
